#!/usr/bin/env bash
# Fast local checks; lint, architecture and tests run before push and in CI.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if command -v mise >/dev/null 2>&1; then run=(mise exec --); else run=(); fi
git diff --cached --check
if git diff --cached --name-only | grep -qE '\.md$|^\.agents/|^scripts/doc-budgets\.tsv$'; then
  scripts/check-docs.sh
fi
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|html|scss|json|js|cjs|md|yml)$' \
  | while read -r f; do [[ -L "$f" ]] || echo "$f"; done)
(( ${#staged[@]} == 0 )) || "${run[@]}" pnpm exec prettier --check --ignore-unknown "${staged[@]}"
