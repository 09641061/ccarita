{
  "name": "ccarita",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "TZ=UTC ng test --watch=false",
    "test:watch": "TZ=UTC ng test",
    "lint": "ng lint",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "theme:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-theme.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:sync": "scripts/sync-api.sh",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm arch && pnpm theme:check && pnpm test && pnpm build",
    "ng": "ng"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "prettier": "^3.8.1",
    "sass": "1.104.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
